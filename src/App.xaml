<Application
    x:Class="PingArmor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Tray context menu (bound to TrayIconViewModel) -->
            <ContextMenu x:Key="TrayMenu">
                <MenuItem Header="{Binding HeaderText}" IsEnabled="False" FontWeight="Bold" />
                <MenuItem
                    Header="{Binding ElevateText}"
                    Command="{Binding RestartAsAdminCommand}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource StatusErrorBrush}"
                    Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVisibility}}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Shield24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding OpenDashboardText}" Command="{Binding OpenDashboardCommand}" FontWeight="Bold">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding StatusText}" IsEnabled="False" />
                <MenuItem Header="{Binding PrimaryAdapterText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="{Binding OptimizeText}" Command="{Binding OptimizeCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding ToggleMonitoringText}" Command="{Binding ToggleMonitoringCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="{Binding MonitoringIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding ExitText}" Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <!-- Tray icon -->
            <tb:TaskbarIcon
                x:Key="TrayIcon"
                NoLeftClickDelay="True"
                ContextMenu="{StaticResource TrayMenu}"
                Icon="{Binding Icon}"
                LeftClickCommand="{Binding OpenDashboardCommand}"
                MenuActivation="RightClick"
                ToolTipText="{Binding ToolTipText}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>