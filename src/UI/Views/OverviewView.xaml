<UserControl
    x:Class="PingArmor.UI.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PingArmor.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignWidth="700"
    d:DesignHeight="480"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:OverviewStatusToBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & command bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Texts.NavOverview}" Style="{StaticResource PageTitleTextStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Command="{Binding OptimizeCommand}" Content="{Binding Texts.OptimizeNowShort}" Margin="0,0,8,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Command="{Binding ToggleProtectionCommand}" Content="{Binding ProtectionButtonText}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding ProtectionIcon}" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Status strip -->
                <Border
                    Margin="0,0,0,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusBrush}}" CornerRadius="12,0,0,12" />

                        <StackPanel Grid.Column="1" Margin="18,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                            </StackPanel>
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" Text="{Binding CheckedAtText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="16,0,18,0" VerticalAlignment="Center">
                            <TextBlock MaxWidth="220" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding WlanStatusText}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource StatusOkBrush}" Margin="0,6,0,0"
                                       Text="{Binding LastOptimizationText}"
                                       Visibility="{Binding HasLastOptimization, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primary channel -->
                <ui:Card Margin="0,0,0,14" Padding="20">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding Texts.ActiveChannelTitle}" />
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,4" Text="{Binding PrimaryAdapterName}" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PrimaryAdapterDetails}" />
                    </StackPanel>
                </ui:Card>

                <!-- Planned changes -->
                <ui:Card Margin="0,0,0,14" Padding="20">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Text="{Binding Texts.PlannedChangesTitle}" />

                        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Texts.PlannedChangesNone}"
                                   Visibility="{Binding HasNoPlannedChanges, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding PlannedChanges}" Visibility="{Binding HasPlannedChanges, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,14,0" Text="{Binding Transition}" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Reason}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button Appearance="Primary" Command="{Binding ApplyPlanCommand}" Content="{Binding Texts.PlannedChangesApply}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                   Visibility="{Binding NeedsOptimization, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Flash24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <!-- Warnings -->
                <ui:InfoBar
                    IsOpen="{Binding HasWarnings, Mode=OneWay}"
                    Message="{Binding WarningsText}"
                    Severity="Warning"
                    Title="{Binding Texts.WarningsTitle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>