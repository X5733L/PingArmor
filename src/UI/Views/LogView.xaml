<UserControl
    x:Class="PingArmor.UI.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PingArmor.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="clr-namespace:PingArmor.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignWidth="700"
    d:DesignHeight="480"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToControlAppearanceConverter x:Key="BoolToAppearance" />
        <conv:LogLevelToBrushConverter x:Key="LevelBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Level filters -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <ui:Button Appearance="{Binding IsLevelAllSelected, Converter={StaticResource BoolToAppearance}}" Command="{Binding SetLevelFilterCommand}" CommandParameter="All" Content="{Binding AllChipText}" FontSize="12" Margin="0,0,6,0" Padding="10,4" />
            <ui:Button Appearance="{Binding IsLevelDebugSelected, Converter={StaticResource BoolToAppearance}}" Command="{Binding SetLevelFilterCommand}" CommandParameter="Debug" Content="{Binding DebugChipText}" FontSize="12" Margin="0,0,6,0" Padding="10,4" />
            <ui:Button Appearance="{Binding IsLevelInfoSelected, Converter={StaticResource BoolToAppearance}}" Command="{Binding SetLevelFilterCommand}" CommandParameter="Info" Content="{Binding InfoChipText}" FontSize="12" Margin="0,0,6,0" Padding="10,4" />
            <ui:Button Appearance="{Binding IsLevelWarnSelected, Converter={StaticResource BoolToAppearance}}" Command="{Binding SetLevelFilterCommand}" CommandParameter="Warn" Content="{Binding WarnChipText}" FontSize="12" Margin="0,0,6,0" Padding="10,4" />
            <ui:Button Appearance="{Binding IsLevelErrorSelected, Converter={StaticResource BoolToAppearance}}" Command="{Binding SetLevelFilterCommand}" CommandParameter="Error" Content="{Binding ErrorChipText}" FontSize="12" Padding="10,4" />
        </WrapPanel>

        <!-- Search + auto-scroll -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:TextBox Width="240" AutomationProperties.Name="{Binding Texts.LogSearchPlaceholder}" PlaceholderText="{Binding Texts.LogSearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ToggleSwitch Margin="16,0,0,0" AutomationProperties.Name="{Binding Texts.LogAutoScroll}" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Content="{Binding Texts.LogAutoScroll}" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
            <ui:Button Appearance="Primary" Command="{Binding OptimizeCommand}" Content="{Binding Texts.OptimizeNowShort}" Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Flash24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding ClearCommand}" Content="{Binding Texts.Clear}" Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Broom24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding OpenFileCommand}" Content="{Binding Texts.LogOpenFile}" Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Document24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding CopyCommand}" Content="{Binding Texts.CopyLog}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- Log list -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Texts.LogEmpty}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ListBox
                    x:Name="LogList"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding EntriesView}"
                    Padding="6"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:LogEntry}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Margin="0,0,10,0" Background="{Binding Level, Converter={StaticResource LevelBrush}}" CornerRadius="2" />
                                <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0" Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Button
                    x:Name="ScrollToBottomButton"
                    Margin="0,0,16,16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Appearance="Secondary"
                    AutomationProperties.Name="{Binding Texts.LogScrollToBottom}"
                    Click="BtnScrollToBottom_Click"
                    ToolTip="{Binding Texts.LogScrollToBottom}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDown24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>